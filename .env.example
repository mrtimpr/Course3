DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=hh_vacancies
DB_MAINTENANCE_DB=postgres

# По требованиям HH API нужен User-Agent :contentReference[oaicite:4]{index=4}
HH_USER_AGENT=Course3HH/1.0 (mailto:you@example.com)

# API pagination (обычно до 100)
HH_PER_PAGE=100

# Можно ограничить, чтобы не тянуть тысячи вакансий (пусто = все страницы)
HH_MAX_PAGES=10